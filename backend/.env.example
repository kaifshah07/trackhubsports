# Database connection strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# Server Port
PORT=5000

# Authentication & JWT
JWT_SECRET="your-secure-jwt-secret-here-at-least-32-chars"

# Dedicated Secret for HMAC-SHA256 OTP Hashing (Recommended for production secret separation).
# If omitted or unconfigured, the system automatically falls back to JWT_SECRET.
# Note: Changing this in a live environment invalidates any unverified OTPs issued in the preceding 5 minutes.
OTP_PEPPER="your-secure-otp-pepper-secret-at-least-32-chars"

# Email Delivery (Brevo HTTP API)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
SENDER_EMAIL="support@trackhubsports.com"
SENDER_NAME="Track Hub Sports"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Google OAuth Authentication
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Allowed CORS Origins (comma-separated, or defaults in code)
# FRONTEND_URL="https://www.trackhubsports.com,https://trackhubsports.com"
